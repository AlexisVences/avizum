# PostgreSQL only. For local development, create the database first.
DATABASE_URL=postgresql+psycopg://avizum:change-me@localhost:5432/avizum
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated origins; leave empty to disable cross-origin browser access.
CORS_ORIGINS=http://localhost:3000

# AI is optional. It initializes on the first legal consultation, never on import.
AI_ENABLED=false
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_CHAT_MODEL=gemma2:2b
AI_EMBEDDING_MODEL=mxbai-embed-large
AI_INDEX_PATH=../data/legal-embeddings
# Existing LangChain FAISS indexes include pickle metadata. Keep false unless the index was rebuilt
# locally from trusted sources and explicitly approved for this deployment.
AI_ALLOW_LEGACY_FAISS_DESERIALIZATION=false
