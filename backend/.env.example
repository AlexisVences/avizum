# PostgreSQL only. For local development, create the database first.
DATABASE_URL=postgresql+psycopg://avizum:change-me@localhost:5432/avizum
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated origins; leave empty to disable cross-origin browser access.
CORS_ORIGINS=http://localhost:3000

# OpenAI powers embeddings (ingestion and search) and the chat agent; without a key, retrieval and chat are unavailable.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-mini
# List prices in USD per million tokens; used only to estimate cost in the admin overview.
LLM_PRICE_INPUT_PER_MILLION=0.25
LLM_PRICE_OUTPUT_PER_MILLION=2.00

# Daily UMA used to turn "N veces la UMA" into pesos. Update every February (INEGI, https://www.inegi.org.mx/temas/uma/).
UMA_VALUE=117.31
UMA_VALID_FROM=2026-02-01
UMA_VALID_UNTIL=2027-01-31
# "production" makes the app refuse to start with the development JWT secret or a localhost CORS origin.
ENVIRONMENT=development
# Set to true only behind a reverse proxy that overwrites X-Forwarded-For (needed for per-address rate limits).
TRUST_PROXY_HEADERS=false
# Public OAuth client ID (Google Cloud Console > Credentials > Web application); empty disables Google sign-in.
GOOGLE_CLIENT_ID=

# Transactional e-mail (verification and password reset). Without RESEND_API_KEY mails are only logged to the console.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Avizum <no-reply@yourdomain.com>".
MAIL_FROM=Avizum <no-reply@yourdomain.com>
# Public base URL of the web app, used in e-mail links (no trailing slash).
FRONTEND_URL=http://localhost:3000
# true: endpoints using the `verified_user` dependency answer 403 until the e-mail is verified.
REQUIRE_VERIFIED_EMAIL=false

# Observability. LOG_FORMAT: json | text | auto (auto = json when ENVIRONMENT=production).
LOG_LEVEL=INFO
LOG_FORMAT=auto
# Error tracking is off unless SENTRY_DSN is set. Sentry is a third-party processor: name it in the privacy notice.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Reported as the release (e.g. the git commit sha injected by your deploy).
GIT_SHA=
